---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HackCard from '../../components/HackCard.astro';
import { t, lp, slugifyCategory, hackLocale, hackSlug } from '../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('hacks');
  const enOnly = all.filter(h => hackLocale(h.id) === 'en');
  const cats = new Map<string, typeof enOnly>();
  for (const h of enOnly) {
    const k = h.data.category;
    if (!cats.has(k)) cats.set(k, []);
    cats.get(k)!.push(h);
  }
  return Array.from(cats.entries()).map(([cat, items]) => ({
    params: { category: slugifyCategory(cat) },
    props: { categoryName: cat, hacks: items },
  }));
}

const { categoryName, hacks } = Astro.props;
const sorted = hacks.sort((a, b) => b.data.date.localeCompare(a.data.date));
const tr = t('en');
---
<Layout title={`${categoryName} — LLM-Hacking`} active="categories" locale="en">
  <section class="py-12">
    <div class="container-main">
      <a href={lp('/categories', 'en')} class="font-mono text-sm text-muted-gray hover:text-matrix-green mb-6 inline-block">{tr.categories.back}</a>

      <div class="flex flex-wrap items-baseline gap-4 mb-3">
        <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">{categoryName}</h1>
        <span class="font-pixel text-3xl text-matrix-green">({hacks.length})</span>
      </div>
      <p class="text-off-white text-lg max-w-2xl mb-10">{hacks.length} {tr.categories.hacks_count}.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sorted.map(h => (
          <HackCard
            href={lp(`/hacks/${hackSlug(h.id)}`, 'en')}
            title={h.data.title}
            excerpt={h.data.excerpt}
            category={h.data.category}
            severity={h.data.severity}
            date={h.data.date}
            readingTime={h.data.readingTime}
            isNew={h.data.isNew}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
