---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TagBadge from '../../components/TagBadge.astro';

export async function getStaticPaths() {
  const hacks = await getCollection('hacks');
  return hacks.map(h => ({ params: { slug: h.id }, props: { hack: h } }));
}

const { hack } = Astro.props;
const { Content } = await hack.render();
const sevLabel = { crit: 'CRITICAL', med: 'MEDIUM', low: 'LOW' }[hack.data.severity];
---
<Layout
  title={`${hack.data.title} — LLM-Hacking`}
  description={hack.data.excerpt}
  active="hacks"
>
  <article class="py-12">
    <div class="container-main max-w-3xl">
      <a href="/hacks" class="font-mono text-sm text-muted-gray hover:text-matrix-green mb-8 inline-block">← back to all hacks</a>

      <div class="flex flex-wrap gap-2 mb-6">
        <TagBadge variant="cat" label={hack.data.category} />
        <TagBadge variant={hack.data.severity} label={sevLabel} />
        {hack.data.isNew && <TagBadge variant="new" label="NEW" />}
      </div>

      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight tracking-tight mb-6">{hack.data.title}</h1>
      <p class="text-xl text-off-white leading-relaxed mb-8">{hack.data.excerpt}</p>

      <div class="flex flex-wrap gap-3 font-mono text-xs text-muted-gray items-center pb-8 mb-10 border-b border-white/[0.08]">
        {hack.data.author && <><span>by <strong class="text-pure-white">{hack.data.author}</strong></span><span class="text-code-gray">//</span></>}
        <span>{hack.data.date}</span>
        <span class="text-code-gray">//</span>
        <span>{hack.data.readingTime}</span>
        {hack.data.affects && hack.data.affects.length > 0 && (
          <><span class="text-code-gray">//</span><span class="text-matrix-green">affects: {hack.data.affects.join(', ')}</span></>
        )}
      </div>

      <div class="prose-content">
        <Content />
      </div>

      {hack.data.sources && hack.data.sources.length > 0 && (
        <section class="mt-12 pt-8 border-t border-white/[0.08]">
          <h2 class="font-mono text-sm text-muted-gray uppercase tracking-widest mb-4">Sources</h2>
          <ul class="space-y-2 font-mono text-sm">
            {hack.data.sources.map(s => (
              <li><a href={s} class="text-matrix-green hover:underline break-all" target="_blank" rel="noopener">→ {s}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Layout>

<style is:global>
  .prose-content {
    color: #C7C7C7;
    line-height: 1.75;
    font-size: 17px;
  }
  .prose-content h2 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 28px;
    color: #fff;
    margin: 40px 0 16px;
    letter-spacing: -0.01em;
  }
  .prose-content h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 22px;
    color: #fff;
    margin: 32px 0 12px;
  }
  .prose-content p { margin: 0 0 18px; }
  .prose-content strong { color: #fff; }
  .prose-content code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.92em;
    background: rgba(0, 255, 148, 0.1);
    color: #00FF94;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .prose-content pre {
    background: #1A0B3D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 18px;
    overflow-x: auto;
    margin: 24px 0;
  }
  .prose-content pre code {
    background: transparent;
    color: #C7C7C7;
    padding: 0;
    font-size: 14px;
    border-radius: 0;
  }
  .prose-content ul, .prose-content ol { margin: 0 0 18px; padding-left: 28px; }
  .prose-content li { margin-bottom: 6px; }
  .prose-content a { color: #00FF94; text-decoration: underline; }
  .prose-content table {
    width: 100%;
    margin: 24px 0;
    border-collapse: collapse;
    font-size: 14px;
  }
  .prose-content th, .prose-content td {
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 14px;
    text-align: left;
  }
  .prose-content th {
    background: rgba(0, 255, 148, 0.08);
    color: #fff;
    font-weight: 500;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .prose-content blockquote {
    border-left: 3px solid #00FF94;
    padding-left: 16px;
    margin: 18px 0;
    color: #9CA3AF;
    font-style: italic;
  }
</style>
