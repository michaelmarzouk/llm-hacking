---
import Layout from '../../../layouts/Layout.astro';
import CategoriesIndexContent from '../../../components/CategoriesIndexContent.astro';
import { t, locales, defaultLocale, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.filter(l => l !== defaultLocale).map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const tr = t(locale);
---
<Layout title={`${tr.categories.title} — LLM-Hacking`} active="categories" locale={locale}>
  <CategoriesIndexContent locale={locale} />
</Layout>
