---
import Layout from '../../../layouts/Layout.astro';
import HacksListContent from '../../../components/HacksListContent.astro';
import { t, locales, defaultLocale, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.filter(l => l !== defaultLocale).map(l => ({ params: { lang: l } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const tr = t(locale);
---
<Layout title={`${tr.footer.all_hacks} — LLM-Hacking`} active="hacks" locale={locale}>
  <HacksListContent locale={locale} />
</Layout>
