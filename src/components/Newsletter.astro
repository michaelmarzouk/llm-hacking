---
---
<section class="py-20 border-t border-white/[0.08]">
  <div class="container-main">
    <div class="bg-gradient-to-br from-deep-indigo to-matrix-green/[0.06] border border-white/[0.16] rounded-2xl p-12 text-center max-w-3xl mx-auto">
      <h3 class="font-mono text-sm text-matrix-green tracking-widest mb-3">&gt; subscribe to /var/log/hacks</h3>
      <h2 class="font-display font-bold text-3xl md:text-4xl leading-tight tracking-tight mb-4">One weekly digest of new attacks.</h2>
      <p class="text-off-white mb-8 max-w-md mx-auto">Every Monday morning. Curated hacks, key papers, defense techniques. No spam, no clickbait. Unsubscribe in one click.</p>
      <form class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto" onsubmit="event.preventDefault();">
        <input
          type="email"
          placeholder="your@email.com"
          required
          class="flex-1 bg-cyber-void border border-white/[0.16] rounded-lg px-4 py-3 text-pure-white font-mono text-sm focus:outline-none focus:border-matrix-green"
        />
        <button type="submit" class="bg-matrix-green text-cyber-void rounded-lg px-6 py-3 font-mono font-medium text-sm hover:bg-matrix-dim transition-colors">$ subscribe</button>
      </form>
    </div>
  </div>
</section>
