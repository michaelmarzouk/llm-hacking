---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 256 256"
  shape-rendering="crispEdges"
  class={className}
  aria-label="LLM-Hacking logo"
  role="img"
>
  <g fill="#00FF94">
    {/* Pixel skull master — 16x16 grid, each cell 16px */}
    {[
      [80,16],[96,16],[112,16],[128,16],[144,16],[160,16],
      [48,32],[64,32],[80,32],[96,32],[112,32],[128,32],[144,32],[160,32],[176,32],[192,32],
      [32,48],[48,48],[64,48],[80,48],[96,48],[112,48],[128,48],[144,48],[160,48],[176,48],[192,48],[208,48],
      [16,64],[32,64],[48,64],[64,64],[80,64],[96,64],[112,64],[128,64],[144,64],[160,64],[176,64],[192,64],[208,64],[224,64],
      [16,80],[32,80],[48,80],[64,80],[80,80],[96,80],[112,80],[128,80],[144,80],[160,80],[176,80],[192,80],[208,80],[224,80],
      [16,96],[32,96],[96,96],[112,96],[128,96],[144,96],[208,96],[224,96],
      [16,112],[32,112],[96,112],[112,112],[128,112],[144,112],[208,112],[224,112],
      [16,128],[32,128],[96,128],[112,128],[128,128],[144,128],[208,128],[224,128],
      [16,144],[32,144],[48,144],[64,144],[80,144],[96,144],[112,144],[128,144],[144,144],[160,144],[176,144],[192,144],[208,144],[224,144],
      [16,160],[32,160],[48,160],[64,160],[80,160],[96,160],[160,160],[176,160],[192,160],[208,160],[224,160],
      [16,176],[32,176],[48,176],[64,176],[80,176],[96,176],[112,176],[128,176],[144,176],[160,176],[176,176],[192,176],[208,176],[224,176],
      [32,192],[48,192],[64,192],[80,192],[96,192],[112,192],[128,192],[144,192],[160,192],[176,192],[192,192],[208,192],
      [32,208],[64,208],[96,208],[128,208],[160,208],[192,208],
      [32,224],[64,224],[96,224],[128,224],[160,224],[192,224],
    ].map(([x, y]) => (
      <rect x={x} y={y} width="16" height="16" />
    ))}
  </g>
  <g fill="#FFFFFF">
    <rect x="64" y="112" width="8" height="8" />
    <rect x="184" y="112" width="8" height="8" />
  </g>
  <g fill="#FF3366">
    <rect x="2" y="120" width="8" height="8" />
    <rect x="246" y="120" width="8" height="8" />
    <rect x="246" y="168" width="8" height="8" />
  </g>
</svg>
