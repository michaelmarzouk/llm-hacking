---
import Logo from './Logo.astro';
import { t, lp, defaultLocale, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const tr = t(locale);

const cols = [
  {
    title: tr.footer.explore,
    links: [
      { href: lp('/hacks', locale),      label: tr.footer.all_hacks },
      { href: lp('/categories', locale), label: tr.footer.categories },
      { href: lp('/research', locale),   label: tr.footer.research },
      { href: lp('/defenses', locale),   label: tr.footer.defenses },
    ],
  },
  {
    title: tr.footer.resources,
    links: [
      { href: '/rss.xml',                label: tr.footer.rss },
      { href: lp('/contribute', locale), label: tr.footer.contribute },
      { href: lp('/about', locale),      label: tr.footer.about },
    ],
  },
  {
    title: tr.footer.follow,
    links: [
      { href: null, label: 'GitHub',     coming: true },
      { href: null, label: 'Twitter',    coming: true },
      { href: null, label: 'Mastodon',   coming: true },
      { href: null, label: 'Newsletter', coming: true },
    ],
  },
];
---
<footer class="border-t border-white/[0.08] pt-12 pb-8 mt-20">
  <div class="container-main">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr_1fr] gap-12 mb-8">
      <div class="flex gap-4 items-start">
        <Logo size={48} />
        <div>
          <h4 class="font-display text-base mb-1">llm-hacking<span class="text-matrix-green">.com</span></h4>
          <p class="text-sm text-muted-gray leading-relaxed">{tr.footer.tagline}</p>
        </div>
      </div>
      {cols.map(col => (
        <div>
          <h5 class="font-mono text-xs text-muted-gray uppercase tracking-widest mb-4">{col.title}</h5>
          <ul class="space-y-2">
            {col.links.map(l => (
              <li>
                {l.href ? (
                  <a href={l.href} class="text-sm text-off-white hover:text-matrix-green transition-colors">{l.label}</a>
                ) : (
                  <span class="text-sm text-muted-gray inline-flex items-center gap-1.5 cursor-not-allowed">
                    {l.label}
                    <span class="font-mono text-[10px] text-code-gray">{tr.footer.coming}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="pt-6 border-t border-white/[0.08] flex justify-between items-center font-mono text-xs text-muted-gray">
      <span>{tr.footer.copyright_pre} <a href="/license" class="hover:text-matrix-green underline decoration-dotted">CC BY-SA 4.0</a> {tr.footer.copyright_post}</span>
      <span class="text-code-gray hidden md:inline">{tr.footer.signoff}</span>
    </div>
  </div>
</footer>
