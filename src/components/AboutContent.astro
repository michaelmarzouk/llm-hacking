---
import { t, lp, defaultLocale, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const tr = t(locale);
---
<section class="py-16">
  <div class="container-main max-w-3xl">
    <div class="font-mono text-sm text-matrix-green mb-4">{tr.about.prompt}</div>
    <h1 class="font-display font-bold text-5xl tracking-tight mb-6">{tr.about.title_pre}<span class="text-matrix-green">.com</span></h1>

    <p class="text-xl text-off-white leading-relaxed mb-6">{tr.about.lead}</p>

    <h2 class="font-display font-bold text-2xl mt-12 mb-4">{tr.about.h_why}</h2>
    <p class="text-off-white leading-relaxed mb-4">{tr.about.why_p1}</p>
    <p class="text-off-white leading-relaxed mb-4">{tr.about.why_p2}</p>

    <h2 class="font-display font-bold text-2xl mt-12 mb-4">{tr.about.h_editorial}</h2>
    <ul class="text-off-white leading-relaxed list-disc pl-6 space-y-2">
      {tr.about.editorial.map(item => <li>{item}</li>)}
    </ul>

    <h2 class="font-display font-bold text-2xl mt-12 mb-4">{tr.about.h_contribute}</h2>
    <p class="text-off-white leading-relaxed mb-4">
      {tr.about.contribute_p_pre} <a href={lp('/contribute', locale)} class="text-matrix-green underline">{tr.about.contribute_p_link}</a> {tr.about.contribute_p_post}
    </p>

    <h2 class="font-display font-bold text-2xl mt-12 mb-4">{tr.about.h_license}</h2>
    <p class="text-off-white leading-relaxed mb-4">
      {tr.about.license_pre} <a href="/license" class="text-matrix-green underline">{tr.about.license_link}</a>{tr.about.license_post}
    </p>
  </div>
</section>
