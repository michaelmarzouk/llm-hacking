---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, lp, type Locale, defaultLocale } from '../i18n/utils';

interface Props {
  active?: 'hacks' | 'categories' | 'about';
  locale?: Locale;
}
const { active, locale = defaultLocale } = Astro.props;
const tr = t(locale);

const links = [
  { href: lp('/hacks', locale),       label: tr.nav.hacks,      id: 'hacks' },
  { href: lp('/categories', locale),  label: tr.nav.categories, id: 'categories' },
  { href: lp('/about', locale),       label: tr.nav.about,      id: 'about' },
] as const;
---
<header class="py-5 border-b border-white/[0.08] sticky top-0 bg-cyber-void/[0.85] backdrop-blur-md z-50">
  <div class="container-main flex justify-between items-center gap-6">
    <a href={lp('/', locale)} class="flex items-center gap-3 font-display font-bold text-lg tracking-tight">
      <Logo size={36} />
      <span class="hidden sm:inline"><span class="text-pure-white">llm-hacking</span><span class="text-matrix-green">.com</span></span>
    </a>

    <nav class="hidden md:flex gap-7 text-sm font-medium">
      {links.map(({ href, label, id }) => (
        <a href={href} class={`transition-colors ${active === id ? 'text-matrix-green' : 'text-off-white hover:text-matrix-green'}`}>{label}</a>
      ))}
    </nav>

    <div class="flex gap-3 items-center">
      <LanguageSwitcher current={locale} />
      <a href={lp('/search', locale)} class="btn-icon" aria-label={tr.nav.search}>⌕</a>
      <a href="/rss.xml" class="btn-icon hidden sm:inline-flex" aria-label="RSS">⌗</a>
    </div>
  </div>
</header>
