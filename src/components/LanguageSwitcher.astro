---
import { locales, defaultLocale, localeFlags, type Locale, lp, stripLocale } from '../i18n/utils';

interface Props {
  current: Locale;
}
const { current } = Astro.props;
const pathNoLocale = stripLocale(Astro.url.pathname);
---
<div class="flex gap-1 font-mono text-xs">
  {locales.map(loc => (
    <a
      href={lp(pathNoLocale, loc as Locale)}
      class={`px-2 py-1 rounded transition-colors ${
        loc === current
          ? 'bg-matrix-green text-cyber-void font-medium'
          : 'text-muted-gray hover:text-matrix-green'
      }`}
      lang={loc}
      hreflang={loc}
      aria-current={loc === current ? 'true' : undefined}
    >
      {localeFlags[loc as Locale]}
    </a>
  ))}
</div>
