---
import { getCollection } from 'astro:content';
import { t, lp, slugifyCategory, defaultLocale, hackLocale, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props;
const tr = t(locale);

const allHacks = (await getCollection('hacks')).filter(h => hackLocale(h.id) === locale);

const counts = new Map<string, number>();
for (const h of allHacks) {
  counts.set(h.data.category, (counts.get(h.data.category) ?? 0) + 1);
}
const categories = Array.from(counts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<section class="py-12">
  <div class="container-main max-w-4xl">
    <div class="font-mono text-sm text-matrix-green mb-4">{tr.categories.prompt}</div>
    <h1 class="font-display font-bold text-5xl tracking-tight mb-4">{tr.categories.title}</h1>
    <p class="text-lg text-off-white leading-relaxed mb-10">{tr.categories.lead}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {categories.map(([cat, n]) => (
        <a
          href={lp(`/categories/${slugifyCategory(cat)}`, locale)}
          class="block border border-white/[0.08] rounded-xl p-6 bg-white/[0.015] transition-all hover:border-matrix-green hover:bg-matrix-green/[0.03] group"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs px-2.5 py-1 rounded bg-matrix-green/10 text-matrix-green border border-matrix-green/30 tracking-wider">{cat}</span>
            <span class="font-pixel text-3xl text-matrix-green leading-none">{n}</span>
          </div>
          <div class="font-mono text-xs text-muted-gray">{n} {tr.categories.hacks_count}</div>
          <div class="mt-4 font-mono text-sm text-matrix-green opacity-0 group-hover:opacity-100 transition-opacity">→ {tr.card.read_more}</div>
        </a>
      ))}
    </div>
  </div>
</section>
